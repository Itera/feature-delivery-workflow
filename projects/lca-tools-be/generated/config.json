{
  "project": {
    "id": "lca-tools-be",
    "stack": [
      "dotnet10",
      "aspnetcore",
      "xunit",
      "moq"
    ]
  },
  "repo": {
    "github": "LCATools/lca-tools-be"
  },
  "git": {
    "story_base": "LCA-2405-agent-docs-pointers",
    "local_dir": ".itera",
    "commit": {
      "subject": "{local_id}: {summary}",
      "subject_must_match": "^(LCA|ANA)-[0-9]+:[[:space:]]*[^[:space:]]",
      "author_name": "Michal Matovcik",
      "author_email": "michal@lca.no"
    }
  },
  "commands": {
    "build": "dotnet build LCATools.slnx -c Release",
    "test": "dotnet test LCA.UnitTests/LCA.UnitTests.csproj -c Release --no-build",
    "test_full": "dotnet test LCATools.slnx -c Release --no-build",
    "boot": {
      "command": "ASPNETCORE_ENVIRONMENT=Development ASPNETCORE_URLS=http://127.0.0.1:5989 dotnet run --project LCA.Api -c Release --no-build --no-launch-profile",
      "port": 5989,
      "ready_regex": "Now listening on",
      "fail_regex": "Unhandled exception|Application startup exception|Host terminated unexpectedly",
      "timeout_s": 120
    }
  },
  "tests": {
    "runner": "dotnet-test",
    "acceptance_glob": "LCA.UnitTests/**/*AcceptanceTests.cs",
    "acceptance_regex": "AcceptanceTests\\.cs",
    "acceptance_hint": "<Thing>AcceptanceTests.cs in the LCA.UnitTests folder that mirrors the production project (e.g. LCA.UnitTests/Shared/<Area>/)",
    "locked_also": [
      "Directory.Build.props",
      "Directory.Packages.props",
      "LCATools.slnx",
      "LCA.UnitTests/LCA.UnitTests.csproj",
      ":(glob)**/*.runsettings",
      ".editorconfig"
    ],
    "contract_errors": "CS0246|CS0234|CS1061|CS0117|CS0103|CS1729|CS7036|CS0535"
  },
  "publish": {
    "mode": "draft-pr",
    "gh_account": "michal-matovcik-lca",
    "assignees": [
      "michal-matovcik-lca"
    ],
    "reviewers": [],
    "never_push": [
      "develop",
      "staging",
      "pre-staging",
      "master",
      "main"
    ],
    "pr_max_words": 250,
    "pr_sections_extra": [
      "human-security-review-flag",
      "review-checklist"
    ]
  },
  "disclosure": {
    "mode": "hidden"
  },
  "platform": {
    "os": "windows"
  }
}
